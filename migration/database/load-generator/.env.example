# ==========================================
# K6 Rehearsal Env (Migration 목적)
# 컷오버 중단/쓰기차단/정합성 이슈 식별용 혼합 부하
# ==========================================

# Target
TARGET_URL=http://test.billages.com/api
WS_URL=ws://test.billages.com/ws
GROUP_ID=1

# Metrics output
K6_OUT=influxdb=http://<monitoring-private-ip>:8086/k6
K6_INSECURE_SKIP_TLS_VERIFY=true

# User/Post bootstrap
SETUP_TIMEOUT=10m
USER_POOL_SIZE=120
SELLER_POOL_SIZE=30
USER_PASSWORD=Qwer1234!
SEED_POSTS_PER_SELLER=6
REPLACE_AFTER_DELETE=true

# setup 우회 모드 (사전 발급 JWT 재사용)
# SKIP_SETUP=true 이면 회원가입/로그인 bootstrap을 수행하지 않음
SKIP_SETUP=false
# 1) JSON 문자열 [{"loginId":"u1","userId":1,"token":"..."}]
PRESET_USERS_JSON=
# 2) JSON 파일 경로 (k6 컨테이너 기준 /scripts/... 경로)
PRESET_USERS_FILE=
# 3) 토큰 나열(쉼표 또는 공백 구분)
PRESET_TOKEN_LIST=
# preset 모드에서 seed 제어
SKIP_SEED_POSTS=false
SKIP_SEED_CHATROOMS=false

# WS scenario
ENABLE_WS=true
WS_VUS=120
WS_DURATION=25m
WS_SESSION_SEC=20
WS_MESSAGE_INTERVAL_MS=500
WS_USER_POOL_SIZE=120
WS_SUCCESS_REQUIRES_MEMBERSHIP=false
WS_HANDSHAKE_AUTH_HEADER=false

# HTTP scenario
HTTP_RPS_MIN=300
HTTP_RPS_MID=450
HTTP_RPS_MAX=600
HTTP_STAGE_1=5m
HTTP_STAGE_2=10m
HTTP_STAGE_3=10m
HTTP_PRE_ALLOCATED_VUS=600
HTTP_MAX_VUS=2000

# Mixed action ratios (GET/POST/PUT/PATCH/DELETE/WS 관련 REST)
ACTION_READ_LIST_RATIO=0.25
ACTION_READ_DETAIL_RATIO=0.20
ACTION_READ_PROFILE_RATIO=0.10
ACTION_READ_MESSAGES_RATIO=0.05
ACTION_CREATE_POST_RATIO=0.15
ACTION_UPDATE_POST_RATIO=0.10
ACTION_PATCH_STATUS_RATIO=0.08
ACTION_DELETE_POST_RATIO=0.02
ACTION_CREATE_CHATROOM_RATIO=0.05

# Thresholds (migration-plan 기준)
STRICT_THRESHOLDS=true
MAX_ERROR_RATE=0.001
MAX_WRITE_BLOCK_RATE=0.01
MAX_UNEXPECTED_WRITE_FAILURE_RATE=0.01
MAX_DOWNTIME_ERROR_RATE=0.01
HTTP_P95_THRESHOLD_MS=500
WRITE_BLOCK_HEADER_NAME=X-Migration-Write-Block
WRITE_BLOCK_HEADER_VALUE=soft-freeze

# Optional fixed token (빈 값이면 setup에서 자동 회원가입/로그인)
AUTH_TOKEN=

# Warmup (read-only)
WARMUP_TARGET_URL=
WARMUP_GROUP_ID=
WARMUP_AUTH_TOKEN=
WARMUP_USER_PASSWORD=Qwer1234!
WARMUP_RPS=20
WARMUP_DURATION=2m
WARMUP_TIMEOUT=15s
WARMUP_PRE_ALLOCATED_VUS=30
WARMUP_MAX_VUS=120
WARMUP_MAX_ERROR_RATE=0.01
WARMUP_P95_MS=1000

# Cutover monitor
CUTOVER_TARGET_URL=
CUTOVER_GROUP_ID=
CUTOVER_AUTH_TOKEN=
CUTOVER_USER_PASSWORD=Qwer1234!
CUTOVER_RPS=300
CUTOVER_DURATION=10m
CUTOVER_TIMEOUT=5s
CUTOVER_DOWNTIME_PROBE_INTERVAL_MS=200
CUTOVER_INCLUDE_WRITE_PROBE=true
CUTOVER_WRITE_PROBE_RATIO=0.30
CUTOVER_MAX_ERROR_RATE=0.05
CUTOVER_MAX_WRITE_BLOCK_RATE=1.0
CUTOVER_MAX_UNPLANNED_DOWNTIME_MS=5000
CUTOVER_P95_MS=3000
CUTOVER_WRITE_BLOCK_HEADER_NAME=
CUTOVER_WRITE_BLOCK_HEADER_VALUE=
