# ==========================================
# Source Server IP (targets 파일용)
# ==========================================
SOURCE_SERVER_IP=10.0.0.10
PROBE_BASE_URL=http://test.billages.com/api

# ==========================================
# RDS external exporter
# ==========================================
RDS_HOST=<rds-endpoint>
RDS_PORT=3306
# 리허설에서는 별도 exporter 계정 대신 앱 DB 계정(예: billage_admin) 재사용 가능
RDS_EXPORTER_USER=<monitor-user>
RDS_EXPORTER_PASSWORD=<monitor-password>

# ==========================================
# Grafana CloudWatch datasource (optional)
# ==========================================
# Discord 알림은 Grafana UI에서 설정:
#   Alerting > Contact points > New > Discord
AWS_ACCESS_KEY_ID=<aws-access-key-id>
AWS_SECRET_ACCESS_KEY=<aws-secret-access-key>
