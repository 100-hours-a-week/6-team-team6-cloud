{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "panels": [
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "id": 100,
      "panels": [],
      "title": "시스템 현황",
      "type": "row"
    },
    {
      "title": "서비스별 로그 유입량",
      "description": "선택한 환경($env)의 각 서비스에서 발생하는 로그 양입니다.",
      "type": "timeseries",
      "id": 1,
      "gridPos": { "h": 7, "w": 8, "x": 0, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (job) (count_over_time({env=\"$env\"}[1m]))",
          "refId": "A",
          "legendFormat": "{{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": { "drawStyle": "bars", "fillOpacity": 70, "lineWidth": 0 },
          "color": { "mode": "palette-classic" },
          "unit": "short"
        }
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["sum", "mean"] }
      }
    },
    {
      "title": "Nginx 응답 상태",
      "type": "piechart",
      "id": 2,
      "gridPos": { "h": 7, "w": 6, "x": 8, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum by (status) (count_over_time({env=\"$env\", job=~\".*nginx.*\", status=~\".+\"}[$__range]))",
          "refId": "A",
          "legendFormat": "{{status}}"
        }
      ],
      "options": {
        "pieType": "donut",
        "legend": { "displayMode": "table", "placement": "right", "values": ["percent", "value"] },
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "200" }, "properties": [{ "id": "color", "value": { "fixedColor": "green", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "500" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      }
    },
    {
      "title": "Nginx 에러 추이",
      "type": "timeseries",
      "id": 3,
      "gridPos": { "h": 7, "w": 10, "x": 14, "y": 1 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({env=\"$env\", job=~\".*nginx.*\", status=~\"5..\"}[1m]))",
          "refId": "A",
          "legendFormat": "5xx 서버 에러"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({env=\"$env\", job=~\".*nginx.*\", status=~\"4..\"}[1m]))",
          "refId": "B",
          "legendFormat": "4xx 클라이언트 에러"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2 }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx 서버 에러" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "4xx 클라이언트 에러" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" }
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 8 },
      "id": 101,
      "panels": [],
      "title": "백엔드 상태",
      "type": "row"
    },
    {
      "title": "Spring 에러 추이",
      "type": "timeseries",
      "id": 4,
      "gridPos": { "h": 8, "w": 15, "x": 0, "y": 9 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({env=\"$env\", job=~\".*backend.*\", level=\"ERROR\"}[1m]))",
          "refId": "A",
          "legendFormat": "ERROR"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({env=\"$env\", job=~\".*backend.*\", level=\"WARN\"}[1m]))",
          "refId": "B",
          "legendFormat": "WARN"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "line", "lineWidth": 2 }, "unit": "short" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "ERROR" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "WARN" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "right" }
      }
    },
    {
      "title": "로그 레벨 통계",
      "type": "stat",
      "id": 5,
      "gridPos": { "h": 8, "w": 9, "x": 15, "y": 9 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({env=\"$env\", job=~\".*backend.*\", level=\"ERROR\"}[$__range]))",
          "refId": "A",
          "legendFormat": "ERROR"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({env=\"$env\", job=~\".*backend.*\", level=\"WARN\"}[$__range]))",
          "refId": "B",
          "legendFormat": "WARN"
        },
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "sum(count_over_time({env=\"$env\", job=~\".*backend.*\", level=\"INFO\"}[$__range]))",
          "refId": "C",
          "legendFormat": "INFO"
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "orientation": "horizontal"
      }
    },
    {
      "collapsed": false,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 17 },
      "id": 102,
      "panels": [],
      "title": "로그 상세",
      "type": "row"
    },
    {
      "title": "최근 에러 로그 (Backend)",
      "type": "logs",
      "id": 6,
      "gridPos": { "h": 12, "w": 24, "x": 0, "y": 18 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{env=\"$env\", job=~\".*backend.*\", level=~\"ERROR|WARN\"}",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    },
    {
      "title": "통합 로그 탐색",
      "description": "선택한 서비스($job)의 로그를 검색어($search)로 필터링합니다.",
      "type": "logs",
      "id": 7,
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 30 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
          "expr": "{env=\"$env\", job=~\"$job\"} |~ \"(?i)$search\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending"
      }
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "templating": {
    "list": [
      {
        "name": "DS_LOKI",
        "type": "datasource",
        "label": "데이터소스",
        "query": "loki",
        "current": {},
        "hide": 0,
        "includeAll": false,
        "multi": false,
        "refresh": 1
      },
      {
        "name": "env",
        "type": "query",
        "label": "환경 (Environment)",
        "description": "Dev 또는 Prod 환경을 선택하세요.",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values(env)",
        "sort": 1,
        "refresh": 1,
        "hide": 0,
        "includeAll": false,
        "multi": false
      },
      {
        "name": "job",
        "type": "query",
        "label": "서비스 (Job)",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": "label_values({env=\"$env\"}, job)",
        "sort": 1,
        "refresh": 1,
        "hide": 0,
        "includeAll": true,
        "multi": true,
        "allValue": ".+"
      },
      {
        "name": "search",
        "type": "textbox",
        "label": "로그 검색",
        "query": "",
        "hide": 0
      }
    ]
  },
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "timezone": "Asia/Seoul",
  "title": "Billages 통합 로그 대시보드",
  "uid": "billages-loki-logs",
  "version": 2
}
