# v2/envs/dev/terraform.tfvars.example
# 실제 사용 시 terraform.tfvars로 복사 후 값 수정

#==============================================================================
# 기본 설정
#==============================================================================
project_name = "billage"
env          = "dev"
aws_region   = "ap-northeast-2"
domain_name  = "billages.com"

#==============================================================================
# 네트워크
# Private Subnets: shared/rds/dev에서 생성 (10.0.10.0/24, 10.0.11.0/24)
#==============================================================================
public_subnet_cidr_c = "10.0.2.0/24"  # AZ-c Public (ALB용)

vpn_cidr = ["10.100.0.0/24"]  # WireGuard VPN

# RDS / ElastiCache는 shared/rds/dev, shared/elasticache/dev에서 관리

#==============================================================================
# EC2 공통 설정
#==============================================================================
golden_ami_id        = "ami-01488502d83cfffa4"  # billage-golden-ami
app_root_volume_size = 20
key_name             = "billage-keypair"
monitoring_loki_url  = "http://10.2.2.42:3100/loki/api/v1/push"

#==============================================================================
# Backend ASG 설정
#==============================================================================
backend_instance_type = "t4g.small"  # 2 vCPU, 2GB
backend_asg_desired   = 1
backend_asg_min       = 1
backend_asg_max       = 1  # Dev: 스케일아웃 비활성화

#==============================================================================
# Frontend ASG 설정
#==============================================================================
frontend_instance_type = "t4g.small"  # 2 vCPU, 2GB
frontend_asg_desired   = 1
frontend_asg_min       = 1
frontend_asg_max       = 1  # Dev: 스케일아웃 비활성화

#==============================================================================
# AI ASG 설정
#==============================================================================
ai_instance_type = "t4g.small"  # 2 vCPU, 2GB
ai_asg_desired   = 1
ai_asg_min       = 1
ai_asg_max       = 1  # Dev: 스케일아웃 비활성화

#==============================================================================
# Health Check
#==============================================================================
backend_health_check_path = "/actuator/health"
ai_health_check_path      = "/health"
